# Graylog GELF HTTP 엔드포인트 설정
# 복수 목적지로 동시 전송할 경우 콤마(,)로 구분하여 입력합니다.
# 첫 번째 URL은 메인 파이프라인(재시도·DLQ·오프셋 커밋), 이후 URL은 비동기 복제(fire-and-forget)로 전송됩니다.
GRAYLOG_GELF_URL=http://host.docker.internal:12201/gelf
# GRAYLOG_GELF_URL=http://host.docker.internal:12201/gelf,http://<SECONDARY_GRAYLOG_IP>:12201/gelf
