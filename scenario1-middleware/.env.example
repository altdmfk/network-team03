# =============================================================================
# SOAR Graylog SIEM Pipeline & Ingestor Environment Configuration (.env)
# =============================================================================

# Graylog GELF HTTP 엔드포인트 설정
# 복수 목적지로 동시 전송할 경우 콤마(,)로 구분하여 입력합니다.
# 첫 번째 URL은 메인 파이프라인(재시도·DLQ·오프셋 커밋), 이후 URL은 비동기 복제(fire-and-forget)로 전송됩니다.
GRAYLOG_GELF_URL=http://host.docker.internal:12201/gelf
# GRAYLOG_GELF_URL=http://host.docker.internal:12201/gelf,http://<SECONDARY_GRAYLOG_IP>:12201/gelf

# Commercial Graylog 6.1 GELF HTTP compatibility:
# Graylog 6.1 HTTP GELF 인풋은 JSON 배열 배치 페이로드를 단일 요청으로 수신하지 못합니다.
# GELF_SPLIT_POST=true 활성화 시 마이크로배치 내 각 GELF 메시지를 병렬 작업자 스레드로 분할 전송합니다.
GELF_SPLIT_POST=true
GELF_SPLIT_MAX_WORKERS=20

# SQLite WAL PRAGMA Tuning (컨테이너 메모리 및 락 타임아웃 튜닝):
# SQLITE_CACHE_SIZE_KB: 음수 지정 시 KB 단위 캐시 크기 (-64000 = 64MB 캐시)
# SQLITE_BUSY_TIMEOUT_MS: SQLite WAL 트랜잭션 락 대기 시간(ms, 기본값 15000ms)
SQLITE_CACHE_SIZE_KB=-64000
SQLITE_BUSY_TIMEOUT_MS=15000

# Pipeline Reliability & Tiered Retry:
ENABLE_TIERED_RETRY=true
MAX_DELIVERY_RETRIES=0
BATCH_SIZE=100
MAX_LOGS_PER_SEC=500.0
