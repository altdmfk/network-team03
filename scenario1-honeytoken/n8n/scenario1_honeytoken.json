        "jsCode": "// 시나리오1: Graylog 허니토큰 이벤트 → IP 차단 요청 데이터\nconst b = $json.body ?? $json;\nif (!b.src_ip) return [];   // IP가 없으면 차단할 수 없으니 중단\n\nreturn [{ json: {\n  ip: b.src_ip,\n  src_ip: b.src_ip,\n  token_id: b.token_id,\n  placement: b.placement,\n  username: b.username,\n  detected_at: b.timestamp,\n  reason: `허니토큰 ${b.token_id}(${b.username}) 사용 — 즉시 차단`,\n  severity: 'Critical',\n  student: 'team3-s1',\n}}];"
      },
